#!/usr/bin/env bash
# Pre-commit guardrail for clawalski.
# Blocks commits that contain known secret patterns; runs lint + typecheck.
# Enabled automatically by the `prepare` script in package.json.

set -euo pipefail

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
dim()   { printf '\033[2m%s\033[0m\n' "$*"; }

# 1. Secret scan over staged additions only.
dim "→ Scanning staged changes for secrets..."

ADDED=$(git diff --cached --diff-filter=AM -U0 -- ':!*.lock' ':!pnpm-lock.yaml' ':!package-lock.json' | grep -E '^\+' | grep -vE '^\+\+\+' || true)

if [ -z "$ADDED" ]; then
  dim "  (no additions to scan)"
else
  declare -a PATTERNS=(
    '[0-9]{8,10}:[A-Za-z0-9_-]{35}'              # Telegram bot token
    'sk-ant-[A-Za-z0-9_-]{20,}'                  # Anthropic API key
    'sk-proj-[A-Za-z0-9_-]{20,}'                 # OpenAI project key
    'ghp_[A-Za-z0-9]{36}'                         # GitHub PAT
    'github_pat_[A-Za-z0-9_]{82}'                # GitHub fine-grained PAT
    'AKIA[0-9A-Z]{16}'                            # AWS access key
    'AIza[A-Za-z0-9_-]{35}'                       # Google API key
    'xox[baprs]-[A-Za-z0-9-]{10,}'                # Slack token
  )

  declare -a NAMES=(
    'Telegram bot token'
    'Anthropic API key'
    'OpenAI project key'
    'GitHub personal access token'
    'GitHub fine-grained PAT'
    'AWS access key'
    'Google API key'
    'Slack token'
  )

  HIT=0
  for i in "${!PATTERNS[@]}"; do
    if echo "$ADDED" | grep -qE "${PATTERNS[$i]}"; then
      red "✗ Possible ${NAMES[$i]} detected in staged content."
      HIT=1
    fi
  done

  # Block obvious env-value commits even without a key prefix
  if echo "$ADDED" | grep -qE '^\+TELEGRAM_BOT_TOKEN=[^[:space:]]+'; then
    red "✗ Staged change sets a non-empty TELEGRAM_BOT_TOKEN= value."
    HIT=1
  fi

  if [ "$HIT" -ne 0 ]; then
    echo
    red "Refusing to commit. Remove the secret from staged content and re-stage."
    echo "If this is a confirmed false positive, refine the patterns in .githooks/pre-commit."
    exit 1
  fi
fi

# 2. Lint (biome).
dim "→ Linting..."
pnpm -s lint

# 3. Typecheck.
dim "→ Typechecking..."
pnpm -s typecheck

green "✓ pre-commit checks passed"
