.DS_Store
Thumbs.db

# ===========================================================================
# Clawalski instance artifacts — these MUST NEVER be committed.
# These patterns catch the case where someone runs `clawalski init` inside
# the repo, or copies an instance dir into the workspace by mistake.
# ===========================================================================

# Env files (contain TELEGRAM_BOT_TOKEN)
.env
.env.*
!.env.example

# Instance config + data
**/access.json
**/crons.json
**/service.json
**/sessions.db*
**/data/
**/workspace/
**/conversations/
**/logs/
instances/

# SQLite WAL artifacts
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
